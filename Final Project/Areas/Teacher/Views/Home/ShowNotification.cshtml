<link href="~/css/notificationpage.css" rel="stylesheet" />

<!-- Notification List -->
<div class="container mt-5 " style="min-height:100vh;" id="notification-list">
    <h3 class="text-2xl md:text-4xl  font-semibold text-center text-gray-800 mb-5" >Your <span class="text-primary " style="font-weight:600;"> Notifications</span></h3>
    <ul class="spacebetween">
        <!-- Notification 1 -->
        <li class="notification-item" id="notification-1">
            <div class="d-flex align-items-center">
                <img src="~/images/0_whPt9R9BXJ5xotoh.jpg" alt="Course 1" class="avatar">
                <div>
                    <strong class="notification-heading">Web Development 101</strong>
                    <p class="notification-text">Learn the fundamentals of web development and build responsive websites. Learn the fundamentals of web development and build responsive websites.</p>

                </div>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#notificationModal1" onclick="lowerOpacity('notification-1')">View</button>
        </li>

        <!-- Notification 2 -->
        <li class="notification-item" id="notification-1">
            <div class="d-flex align-items-center">
                <img src="~/images/0_whPt9R9BXJ5xotoh.jpg" alt="Course 1" class="avatar">
                <div>
                    <strong class="notification-heading">Web Development 101</strong>
                    <p class="notification-text">Learn the fundamentals of web development and build responsive websites. Learn the fundamentals of web development and build responsive websites.</p>

                </div>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#notificationModal2" onclick="lowerOpacity('notification-2')">View</button>
        </li>

    </ul>
</div>
<!-- Modal for Notification 1 -->
<!-- Modal for Notification 1 -->
<div class="modal fade" id="notificationModal1" tabindex="-1" aria-labelledby="notificationModalLabel1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 70%; margin: auto;">
        <div class="modal-content bg-light">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="notificationModalLabel1">Course Notification</h5>
                <button type="button" class="btn-close text-white border-0 closre" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <h5 class="text-xl font-semibold text-dark">Web Development 101</h5>
                <!-- Centered and resized image -->
                <img src="~/images/0_whPt9R9BXJ5xotoh.jpg" alt="Course 1" class="img-fluid mb-4 rounded mx-auto d-block" style="max-width: 200px; height: auto;">
                <p style="color:#494848 !important;">Learn the fundamentals of web development and build responsive websites using HTML, CSS, and JavaScript. This course will take you from beginner to intermediate level in no time!</p>
                <p><strong>Topics covered:</strong> HTML, CSS, JavaScript, Responsive Design, and more.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" onclick="restoreOpacity('notification-1')">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Notification 2 -->
<div class="modal fade" id="notificationModal2" tabindex="-1" aria-labelledby="notificationModalLabel2" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 70%; margin: auto;">
        <div class="modal-content bg-light">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="notificationModalLabel2">Course Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <h5 class="text-xl font-semibold text-dark">Advanced Machine Learning</h5>
                <!-- Centered and resized image -->
                <img src="~/images/0_whPt9R9BXJ5xotoh.jpg" alt="Course 2" class="img-fluid mb-4 rounded mx-auto d-block" style="max-width: 200px; height: auto;">
                <p style="color:#494848 !important;">Dive deep into advanced machine learning techniques and algorithms. This course is designed for those looking to master the subject in real-world applications.</p>
                <p><strong>Topics covered:</strong> Supervised Learning, Neural Networks, Deep Learning, Reinforcement Learning, and more.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" onclick="restoreOpacity('notification-2')">Close</button>
            </div>
        </div>
    </div>
</div>





<script>
    <script>

          function lowerOpacity(notificationId) {
              const notificationItem = document.getElementById(notificationId);
              notificationItem.style.add('opacity-50');
          }

          function restoreOpacity(notificationId) {
              const notificationItem = document.getElementById(notificationId);
              notificationItem.classList.remove('opacity-50');
          }
          // Get modal elements
          const modal1 = document.getElementById('notificationModal1');
          const modal2 = document.getElementById('notificationModal2');
          const notificationList = document.getElementById('notification-list');

          modal1.addEventListener('show.bs.modal', function () {
              notificationList.classList.add('opacity-50', 'blur-sm');
          });

          modal1.addEventListener('hidden.bs.modal', function () {
              notificationList.classList.remove('opacity-50', 'blur-sm');
          });

          modal2.addEventListener('show.bs.modal', function () {
              notificationList.classList.add('opacity-50', 'blur-sm');
          });

          modal2.addEventListener('hidden.bs.modal', function () {
              notificationList.classList.remove('opacity-50', 'blur-sm');
          });
</script>



</script>